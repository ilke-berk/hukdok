# ========================================
# HukuDok Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values

# ========================================
# SharePoint Configuration
# ========================================
SHAREPOINT_TENANT_ID=your-tenant-id-here
SHAREPOINT_CLIENT_ID=your-client-id-here
SHAREPOINT_CLIENT_SECRET=your-client-secret-here
# Entra'daki client secret'ın bitis tarihi (ISO, YYYY-MM-DD). Bos birakilabilir:
# bossa hicbir sey olmaz. Doluysa acilista kalan gun <=30 -> WARNING,
# tarih gecmis -> CRITICAL loglanir (secret'in kendisi loglanmaz). G093.
SHAREPOINT_CLIENT_SECRET_EXPIRES_AT=
SHAREPOINT_SITE_URL=https://yourcompany.sharepoint.com/sites/yoursite
SHAREPOINT_DRIVE_NAME=Documents

# SharePoint List Names
SHAREPOINT_LOG_LIST_NAME=log
SHAREPOINT_COUNTER_LIST_NAME=Counter

# SharePoint Folder Names
SHAREPOINT_FOLDER_HAM_NAME=01_HAM_ARSIV
SHAREPOINT_FOLDER_ISLENMIS_NAME=02_YEDEK_ARSIV
SHAREPOINT_TARGET_FOLDER=YourTargetFolder

# ========================================
# Gemini AI Configuration
# ========================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash-lite

# Otonom dava acma intake motorunun modeli (/api/case-intake/analyze).
# /process'in flash-lite'indan AYRI: kalibrasyonda sigortali cikarimi
# flash-lite'ta 9/15, 3.6-flash'ta 16/16. Tanimsizsa varsayilan budur.
GEMINI_INTAKE_MODEL=models/gemini-3.6-flash

# ========================================
# Email Configuration
# ========================================
EMAIL_ENABLED=false
EMAIL_SENDER=notifications@yourcompany.com
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=your-test-email@yourcompany.com

# Bildirim hedefleme allowlist'i (G080, services/notification_targeting.py).
# Davanin sorumlu avukati YALNIZ bu alan adlarindan birine sahip bir adrese
# cozulebilir; dis avukatlarin kisisel adresleri (gmail/hotmail) yapisal olarak
# disarida kalir. Virgulle ayrilir; tanimsiz/bos birakilirsa varsayilan ofis
# alan adi kullanilir (hanyaloglu-acar.av.tr).
NOTIFICATION_DOMAINS=hanyaloglu-acar.av.tr

# ========================================
# Application Settings
# ========================================
# DEV_MODE prod'da daima false/tanımsız olmalıdır. true olması zayıf export
# anahtarlarına izin verir ve (ENV=development + ALLOW_DEV_TENANT=true ile
# birlikte) imzasız dev token bypass'ını açar.
DEV_MODE=false

# CORS beyaz listesi (virgülle ayrılmış origin'ler). Tanımsızsa güvenli default
# kullanılır: https://hukukoid.com + localhost geliştirme portları (8080/8000/5173).
# ALLOWED_ORIGINS=https://hukukoid.com,http://localhost:8080

# Comma-separated Azure AD tenant IDs allowed to authenticate
ALLOWED_TENANTS=your-tenant-id-1,your-tenant-id-2

# Frontend SPA app registration's client_id. Backend, gelen JWT'nin aud claim'ini
# bu değere ("api://<id>" veya direkt "<id>") karşı doğrular.
AZURE_CLIENT_ID=your-frontend-client-id-here

# Comma-separated admin email addresses (case-insensitive)
ADMIN_EMAILS=admin@yourcompany.com

# Cache expiry in days
CACHE_EXPIRY_DAYS=30

# ========================================
# Hukukbot Export API (docs/hukukbot-aktarim/PLAN.md)
# ========================================
# /export route'larini koruyan paylasimli anahtar (X-API-Key header'i).
# Tanimsiz birakilirsa export API kapalidir (tum istekler 503 alir).
HUKDOK_EXPORT_API_KEY=

# Aktarilacak belge turu kodlari (virgul ayrimli, KISA kodlar — pad'siz).
# Aday liste: docs/hukukbot-aktarim/KOD_LISTESI.md. Bos birakilirsa tur
# filtresi uygulanmaz. Prod'da .env degisikligi "up -d" (recreate) gerektirir.
HUKDOK_EXPORT_TYPES=GEREKCELI-KRR,ARA-KRR,EK-KRR,ISTINAF-KRR,YARGITAY-KRR,DANISTAY-KRR,AYM-KRR,KRR_DZLTM-KRR,EMSAL-KRR,BILIRKISI-RPR,BLRKSI-RPR-EK,ATK-RPR

# Hukukbot webhook'u (Faz 3): outbox satiri acilinca aninda haber verilir.
# URL ortak Docker network'unden cozunur (Faz 4'te kurulur):
#   HUKUKBOT_WEBHOOK_URL=http://hukukbot_api:8010/ingest/hukdok
# Tanimsizsa webhook atlanir — belgeler yine outbox'a yazilir ve hukukbot'un
# periyodik reconcile'i (30 dk) toparlar. Anahtar, hukukbot'taki
# INGEST_API_KEY ile ayni secret olmalidir.
HUKUKBOT_WEBHOOK_URL=
HUKUKBOT_INGEST_API_KEY=

# ========================================
# SSL/TLS Configuration (Optional)
# ========================================
# Path to custom SSL certificate bundle if needed
# SSL_CERT_FILE=/path/to/your/certificate.pem
