# HTTP -> HTTPS yönlendirme
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name hukukoid.com www.hukukoid.com;
    return 301 https://$host$request_uri;
}

# Ana HTTPS sunucu
server {
    listen 443 ssl;
    server_name hukukoid.com www.hukukoid.com;

    # SSL (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/hukukoid.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hukukoid.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Dosya yükleme limiti
    client_max_body_size 50M;

    # Timeout ayarları
    proxy_read_timeout 300s;
    proxy_connect_timeout 300s;

    # Tüm trafik frontend container üzerinden
    location / {
        proxy_pass http://localhost:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass_header Authorization;
    }
}

